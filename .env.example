# Run make init-env: creates ignored .env with mode 0600 and local random keys.
# Compose reads .env automatically. Never paste its contents into chat/logs.

# Supabase Project URL + /auth/v1, and Settings > API Keys > Publishable key.
PORTWAY_AUTH_URL=https://YOUR-PROJECT-REF.supabase.co/auth/v1
PORTWAY_AUTH_PUBLISHABLE_KEY=

# Connect > Session pooler > URI. Copy the exact host; do not derive it from region.
# Use port 5432, database postgres, sslmode=verify-full. Percent-encode passwords.
# Migration: postgres.PROJECT-REF with the project's DATABASE password.
# API: portway_app.PROJECT-REF with a SEPARATE password for the portway_app role.
# Example (replace every placeholder, including the password):
# postgres://postgres.PROJECT-REF:PERCENT-ENCODED-PASSWORD@EXACT-POOLER-HOST:5432/postgres?sslmode=verify-full
PORTWAY_MIGRATION_DATABASE_URL=
PORTWAY_DATABASE_URL=
PORTWAY_DATABASE_MAX_CONNS=2
# Generated by scripts/provision-db.py after the operator connection works.
PORTWAY_RELAY_DATABASE_URL=
PORTWAY_AUDIT_DATABASE_URL=

# Filled by make init-env. These are Portway secrets, NOT Supabase API keys.
PORTWAY_INSTALLATION_ID=
PORTWAY_MASTER_KEY=
PORTWAY_SETUP_TOKEN=
PORTWAY_INSTALLATION_NAME=Portway

# Replace with the actual HTTPS tunnel URL (e.g. the stable Tailscale Funnel URL).
# Use the same URL in Supabase Site URL and its /auth/confirm Redirect URL.
# This placeholder only allows local configuration; it is not a public deployment.
PORTWAY_PUBLIC_URL=https://localhost
PORTWAY_PORT=8080
PORTWAY_LLM_ALLOWED_ENDPOINTS=

# Kafka is isolated on the internal Compose network; no external broker credentials.

# Generated by provisioning; execution has no access to control/audit schemas.
PORTWAY_EXECUTION_DATABASE_URL=
PORTWAY_EXECUTION_SERVICE_KEY=
# Enable with the execution profile after its integration checks pass.
PORTWAY_EXECUTION_URL=
# Optional override of the pinned official Tailscale image in compose.funnel.yaml.
PORTWAY_TAILSCALE_IMAGE=tailscale/tailscale@sha256:c507f3a2a6ab1cabd8d809b98edeb41edbd5c3fb6ad9632ffd098b4c7d0b4065

# Set execution,funnel after provisioning/login to include both in ordinary compose up.
COMPOSE_PROFILES=

# Cloud models currently allow only explicit OpenRouter :free IDs with current
# zero pricing. Paid/automatic routes and paid plugins are rejected.
# This key is passed ONLY to control-api, never to execution/events/agent containers.
OPENROUTER_API_KEY=
PORTWAY_OPENROUTER_MODEL=
PORTWAY_MODEL_POLICY=free_only

# Optional native agent demo profile (Codex CLI + Claude Code). Same dedicated key on API and laptop bridge.
PORTWAY_CODEX_BRIDGE_KEY=
# Native laptop process only (do not mount Codex/Claude auth into API containers):
PORTWAY_CODEX_API_URL=http://127.0.0.1:8080
PORTWAY_CODEX_WORKSPACE=/absolute/path/to/workspace
# Empty = look up `codex` / `claude` in PATH; a missing CLI is shown as not installed.
PORTWAY_CODEX_BINARY=
PORTWAY_CLAUDE_BINARY=
# Extra AI account profiles + active selection; empty = $XDG_DATA_HOME/portway/bridge (~/.local/share/...).
PORTWAY_BRIDGE_DATA_DIR=
